# Local dev env template — copy to .env and fill (`cp .env.example .env`).
# Only local metro needs .env; EAS builds read the eas.json profile env
# blocks instead. All values here are client-public by design (they ship
# in every binary) — but .env stays gitignored anyway.
#
# Where each value lives:
#   Supabase URL + anon key ... Supabase dashboard → project urqpiwxapckaiorvdvfi
#                               → Settings → API (anon/publishable key)
#   Google client IDs ......... committed eas.json build env blocks
#   RevenueCat public keys .... committed eas.json build env blocks
#                               (or RC dashboard → Project → API keys)

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# NOTE: no EXPO_PUBLIC_ prefix on these two — they reach the app via
# app.config.ts `extra:`, not by bundle inlining.
RC_PUBLIC_IOS_KEY=
RC_PUBLIC_ANDROID_KEY=
# Home + Garage v3 (feat/home-garage-v3). Unset = follows the quiz flag;
# 1/0 to split them. See lib/featureFlags.ts.
EXPO_PUBLIC_HOME_GARAGE_V3=
